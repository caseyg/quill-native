// Device signing is machine-local. See Signing.local.example.xcconfig.
CODE_SIGN_STYLE = Automatic
REGISTER_APP_GROUPS = YES
// The public page that identifies this app to IndieAuth servers (docs/index.html, served by GitHub Pages).
// A fork should point this at a page it hosts. "/$()/" keeps "//" from starting a comment.
QUILL_CLIENT_ID = https:/$()/caseyg.github.io/quill-native/
// The public client ID of a GitHub OAuth app with Device Flow enabled, for Settings → Drafts on GitHub.
// A fork should use its own. Empty means people sign in with a token instead. Client IDs are not secret; no client secret is used.
QUILL_GITHUB_CLIENT_ID = Ov23liDE6sAoVfVPqX5h
#include? "Signing.local.xcconfig"
